<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========================================== -->
    <!-- 1. TEMA PRINCIPAL DE NEXORA               -->
    <!-- ========================================== -->

    <style name="Theme.NEXORAADVENTURES"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">
            @color/nexora_primary
        </item>

        <item name="colorPrimaryVariant">
            @color/nexora_primary_dark
        </item>

        <item name="colorSecondary">
            @color/nexora_secondary
        </item>

        <item name="android:windowBackground">
            @color/nexora_background
        </item>

        <item name="android:statusBarColor">
            @color/nexora_primary_dark
        </item>

        <item name="android:navigationBarColor">
            @color/nexora_primary_dark
        </item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

    </style>


    <!-- ========================================== -->
    <!-- 2. TEMA SPLASH NATIVO DE ANDROID           -->
    <!-- ========================================== -->

    <style name="Theme.NEXORAADVENTURES.Splash"
        parent="Theme.SplashScreen">

        <!-- Fondo del Splash nativo -->
        <item name="windowSplashScreenBackground">
            @color/nexora_primary
        </item>

        <!-- Logotipo de NEXORA -->
        <item name="windowSplashScreenAnimatedIcon">
            @drawable/ic_nexora_logo
        </item>

        <!-- Tema que se aplica inmediatamente después -->
        <item name="postSplashScreenTheme">
            @style/Theme.NEXORAADVENTURES.SplashContent
        </item>

    </style>


    <!-- ========================================== -->
    <!-- 3. TEMA INTERMEDIO DE SPLASHACTIVITY       -->
    <!-- ========================================== -->

    <style name="Theme.NEXORAADVENTURES.SplashContent"
        parent="Theme.NEXORAADVENTURES">

        <!-- Fondo verde antes de cargar activity_splash.xml -->
        <item name="android:windowBackground">
            @color/nexora_primary
        </item>

        <!-- Barras del sistema -->
        <item name="android:statusBarColor">
            @color/nexora_primary_dark
        </item>

        <item name="android:navigationBarColor">
            @color/nexora_primary_dark
        </item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

    </style>

</resources>
