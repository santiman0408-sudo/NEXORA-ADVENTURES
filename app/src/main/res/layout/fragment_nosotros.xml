<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexora_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ENCABEZADO INSTITUCIONAL -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nexora_primary"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="NEXORA ADVENTURES"
                    android:textColor="@android:color/white"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Explora. Descubre. Vive."
                    android:textColor="#FFE0B2"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Descubre nuevas experiencias y vive la aventura recorriendo los destinos del Perú."
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- QUIÉNES SOMOS -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="QUIÉNES SOMOS"
                    android:textColor="@color/nexora_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtQuienesSomos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Somos NEXORA ADVENTURES, una empresa turística dedicada a ofrecer experiencias de aventura, recorridos culturales y contacto con los paisajes naturales del Perú. Buscamos que cada viajero descubra nuevos destinos mediante experiencias organizadas y memorables."
                    android:textColor="#263238"
                    android:textSize="16sp"
                    android:lineSpacingExtra="5sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- MISIÓN -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NUESTRA MISIÓN"
                    android:textColor="@color/nexora_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Brindar experiencias turísticas seguras, organizadas y memorables, promoviendo el conocimiento de los destinos naturales y culturales del Perú, con atención responsable y cercana a nuestros clientes."
                    android:textColor="#263238"
                    android:textSize="16sp"
                    android:lineSpacingExtra="5sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- VISIÓN -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NUESTRA VISIÓN"
                    android:textColor="@color/nexora_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtVision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Ser una empresa reconocida por la calidad de sus experiencias turísticas, la atención al cliente y el compromiso con el turismo responsable, conectando a más viajeros con la riqueza natural y cultural del país."
                    android:textColor="#263238"
                    android:textSize="16sp"
                    android:lineSpacingExtra="5sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- VALORES -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NUESTROS VALORES"
                    android:textColor="@color/nexora_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtValores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="• Responsabilidad: cumplir nuestros compromisos con cada viajero.\n\n• Seguridad: priorizar el bienestar durante las actividades.\n\n• Respeto: cuidar la naturaleza y las comunidades locales.\n\n• Compromiso: ofrecer una atención de calidad.\n\n• Trabajo en equipo: colaborar para brindar mejores experiencias."
                    android:textColor="#263238"
                    android:textSize="16sp"
                    android:lineSpacingExtra="5sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- SERVICIOS TURÍSTICOS -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NUESTROS SERVICIOS"
                    android:textColor="@color/nexora_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtServicios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="• Excursiones guiadas.\n\n• Rutas culturales e históricas.\n\n• Turismo de naturaleza.\n\n• Viajes grupales.\n\n• Experiencias de aventura."
                    android:textColor="#263238"
                    android:textSize="16sp"
                    android:lineSpacingExtra="5sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- MENSAJE FINAL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="NEXORA ADVENTURES\nExplora. Descubre. Vive."
            android:textColor="@color/nexora_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:lineSpacingExtra="5sp" />

    </LinearLayout>

</ScrollView>
