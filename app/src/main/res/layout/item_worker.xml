<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"

    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E7E4"
    app:cardBackgroundColor="@color/nexora_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- NOMBRE Y ESTADO LABORAL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtWorkerNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nombre del trabajador"
                android:textColor="@color/nexora_primary"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtWorkerEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="ACTIVO"
                android:textColor="@color/nexora_text_light"
                android:textSize="10sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- CARGO -->

        <TextView
            android:id="@+id/txtWorkerCargo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cargo"
            android:textColor="@color/nexora_text"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <!-- ÁREA -->

        <TextView
            android:id="@+id/txtWorkerArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Área de trabajo"
            android:textColor="@color/nexora_text"
            android:textSize="13sp"/>

        <!-- DOCUMENTO -->

        <TextView
            android:id="@+id/txtWorkerDocumento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="DNI: 12345678"
            android:textColor="@color/nexora_text"
            android:textSize="13sp"/>

        <!-- TELÉFONO -->

        <TextView
            android:id="@+id/txtWorkerTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Teléfono: 999999999"
            android:textColor="@color/nexora_text"
            android:textSize="13sp"/>

        <!-- CORREO -->

        <TextView
            android:id="@+id/txtWorkerCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Correo: trabajador@nexora.com"
            android:textColor="@color/nexora_text"
            android:textSize="13sp"/>

        <!-- FECHA DE CONTRATACIÓN -->

        <TextView
            android:id="@+id/txtWorkerFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Ingreso: 01/01/2026"
            android:textColor="@color/nexora_text"
            android:textSize="13sp"/>

        <!-- SUELDO MENSUAL -->

        <TextView
            android:id="@+id/txtWorkerSueldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sueldo mensual: S/ 2,000.00"
            android:textColor="@color/nexora_primary"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <!-- BOTONES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWorkerEditar"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="EDITAR"
                android:textSize="11sp"
                android:textColor="@color/nexora_primary"
                app:backgroundTint="@color/nexora_background"
                app:cornerRadius="9dp"
                app:strokeColor="@color/nexora_primary"
                app:strokeWidth="1dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWorkerEliminar"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="ELIMINAR"
                android:textSize="11sp"
                android:textColor="@color/nexora_text_light"
                app:backgroundTint="@color/nexora_primary"
                app:cornerRadius="9dp"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
