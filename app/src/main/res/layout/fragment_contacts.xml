<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexora_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ENCABEZADO -->

        <TextView
            android:id="@+id/txtTituloContactos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contáctanos"
            android:textColor="@color/nexora_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans" />

        <TextView
            android:id="@+id/txtDescripcionContactos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:text="¿Tienes alguna consulta sobre nuestras aventuras? Escríbenos y registra tu mensaje."
            android:textColor="#263238"
            android:textSize="16sp"
            android:lineSpacingExtra="4sp" />

        <!-- TARJETA DEL FORMULARIO -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Formulario de contacto"
                    android:textColor="@color/nexora_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- NOMBRE -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNombreContacto"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Nombre completo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombreContacto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1"
                        android:maxLength="100" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- CORREO -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCorreoContacto"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Correo electrónico">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCorreoContacto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:maxLength="150" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- TELEFONO -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTelefonoContacto"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Teléfono de contacto">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTelefonoContacto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:maxLength="20" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ASUNTO -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAsuntoContacto"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Asunto de la consulta">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAsuntoContacto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:maxLength="120" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- MENSAJE -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMensajeContacto"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:hint="Escribe tu mensaje">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMensajeContacto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="4"
                        android:maxLines="7"
                        android:maxLength="1000" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- BOTÓN ENVIAR -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnviarConsulta"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="ENVIAR CONSULTA"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/nexora_primary"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_menu_send"
                    app:iconGravity="textStart"
                    app:iconTint="@android:color/white" />

                <!-- BOTÓN LIMPIAR -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLimpiarFormulario"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="LIMPIAR FORMULARIO"
                    android:textStyle="bold"
                    android:textColor="@color/nexora_primary"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/nexora_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- AVISO DE ALMACENAMIENTO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Tu consulta quedará registrada en la aplicación para su seguimiento."
            android:textColor="#607D8B"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
